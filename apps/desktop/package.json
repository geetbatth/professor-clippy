{
  "name": "@clippy/desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Professor Clippy desktop app (Electron).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config src/renderer/vite.config.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "harness": "node scripts/run-harness.mjs",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "package": "electron-builder --config electron-builder.yml --win --publish never"
  },
  "dependencies": {
    "@clippy/shared": "0.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrule": "2.8.1",
    "ulid": "3.0.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.5"
  }
}
